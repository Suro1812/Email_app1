        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Push staleness (worst)",
      "description": "Seconds since the longest-overdue component last pushed successfully. Pushgateway serves stale values forever after a pusher dies — there is no 'up' for a push, so this gauge is the substitute. Red means something that should be pushing has stopped; it does NOT mean pushgateway itself is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 53
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - email_reminders_last_push_timestamp_seconds{component=~\"$component\"})",
          "legendFormat": "staleness"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 45
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
