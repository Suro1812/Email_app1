{
  "uid": "email-reminders-observability",
  "title": "Email Reminders — Tools & Hooks",
  "description": "Gmail tool calls and sanitization hook activity emitted by app/observability.py.",
  "tags": [
    "email-reminders",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "component",
        "label": "Component",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "email-reminders-prom"
        },
        "query": "label_values(email_reminders_tool_calls_total, component)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tool",
        "label": "Tool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "email-reminders-prom"
        },
        "query": "label_values(email_reminders_tool_calls_total, tool_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "hook",
        "label": "Hook",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "email-reminders-prom"
        },
        "query": "label_values(email_reminders_hook_calls_total, hook_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Showing data for:** ${__from:date:MMM D, HH:mm} → ${__to:date:MMM D, HH:mm}  _(change with the time picker, top-right)_"
      },
      "transparent": true
    },
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Scrape targets up",
      "description": "Should read 2 (api + worker), the two DIRECTLY-SCRAPED processes (local dev / compose). Does not include the pushgateway job — see 'Pushgateway reachable' and 'Push staleness' below for the ACA-over-ngrok push path, which has different failure modes.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"email-reminders-api|email-reminders-worker\"})",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Tool calls / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(email_reminders_tool_calls_total{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval]))",
          "legendFormat": "calls/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Tool error ratio",
      "description": "Share of tool calls that raised. status is only ever success or error. clamp_min keeps the panel at 0 instead of NaN when there is no traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(email_reminders_tool_calls_total{component=~\"$component\", tool_name=~\"$tool\", status=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(email_reminders_tool_calls_total{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval])), 0.0000001)",
          "legendFormat": "error ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Emails sanitized / min",
      "description": "post_tool_process_gmail_message runs once per Gmail message read, so its rate is effectively email throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(email_reminders_hook_calls_total{hook_name=\"post_tool_process_gmail_message\"}[$__rate_interval])) * 60",
          "legendFormat": "emails/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "p95 tool latency",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(email_reminders_tool_call_duration_seconds_bucket{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Emails processed",
      "description": "${__from:date:MMM D, HH:mm} → ${__to:date:MMM D, HH:mm} — Gmail messages fully read and sanitized in this window.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(email_reminders_hook_calls_total{hook_name=\"post_tool_process_gmail_message\"}[$__range]))",
          "legendFormat": "Emails processed",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Tool calls",
      "description": "${__from:date:MMM D, HH:mm} → ${__to:date:MMM D, HH:mm} — every instrumented tool invocation.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(email_reminders_tool_calls_total{component=~\"$component\", tool_name=~\"$tool\"}[$__range]))",
          "legendFormat": "Tool calls (total)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Tool errors",
      "description": "${__from:date:MMM D, HH:mm} → ${__to:date:MMM D, HH:mm} — tool calls that raised.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(email_reminders_tool_calls_total{component=~\"$component\", tool_name=~\"$tool\", status=\"error\"}[$__range]))",
          "legendFormat": "Tool errors (total)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "HTTP requests",
      "description": "${__from:date:MMM D, HH:mm} → ${__to:date:MMM D, HH:mm} — all requests handled by the API.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(email_reminders_http_requests_total[$__range]))",
          "legendFormat": "HTTP requests (total)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "state-timeline",
      "title": "Scrape health over time",
      "description": "One lane per target. Green = that scrape succeeded, red = it failed, a gap = Prometheus itself was not running. Read this before trusting any panel below: a red stretch means the data there is missing, not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"email-reminders-.*\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "row",
      "title": "Gmail tools",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tool call rate by tool",
      "description": "read_gmail_message wraps gmail.messages.get, extract_body, check_promotional_basic and others. These lines are nested, not additive — summing them double-counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool_name) (rate(email_reminders_tool_calls_total{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval]))",
          "legendFormat": "{{tool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisLabel": "calls/s"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tool latency p95 by tool",
      "description": "Buckets top out at 120s. A series pinned flat at 120 means the real value is above the highest bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tool_name) (rate(email_reminders_tool_call_duration_seconds_bucket{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "{{tool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisLabel": "p95"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tool errors by tool",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool_name) (rate(email_reminders_tool_calls_total{component=~\"$component\", tool_name=~\"$tool\", status=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{tool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tool latency percentiles (all selected tools)",
      "description": "mean comes from _sum / _count, which is exact; the percentiles are interpolated from buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(email_reminders_tool_call_duration_seconds_bucket{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(email_reminders_tool_call_duration_seconds_bucket{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(email_reminders_tool_call_duration_seconds_bucket{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval])))",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "expr": "sum(rate(email_reminders_tool_call_duration_seconds_sum{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval])) / clamp_min(sum(rate(email_reminders_tool_call_duration_seconds_count{component=~\"$component\", tool_name=~\"$tool\"}[$__rate_interval])), 0.0000001)",
          "legendFormat": "mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Sanitization & security hooks",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Hook call rate by hook",
      "description": "The _decompose_* hooks strip dangerous tags and hidden prompt-injection carriers out of email HTML before it reaches the model.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
