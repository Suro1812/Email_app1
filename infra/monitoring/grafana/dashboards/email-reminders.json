    {
      "type": "stat",
      "title": "Pushgateway reachable",
      "description": "Is Prometheus able to scrape the pushgateway itself. This says nothing about whether any app is actually pushing to it — a dead ACA app and an idle one look identical here. See 'Push staleness' for that.",
      "datasource": {
        "type": "prometheus",
        "uid": "email-reminders-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 53
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"email-reminders-pushgateway\"})",
          "legendFormat": "up"
        }
