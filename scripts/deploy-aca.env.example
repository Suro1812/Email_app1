# Copy this file to a local deploy env file or export these values before running
# scripts/deploy-aca.sh. Keep real secret values out of git.

# Versioning: use an immutable release version for every deployment.
# Examples: 0.1.1, 2026.07.15.1, 0.1.1-rc.1
VERSION=0.1.1

AZURE_RESOURCE_GROUP=rg-email-reminders
AZURE_LOCATION=eastus

# Azure Container Registry name, without .azurecr.io.
ACR_NAME=myregistry
IMAGE_NAME=email-reminders

# Azure Container Apps.
ACA_ENV_NAME=email-reminders-env
ACA_API_APP_NAME=email-reminders-api
ACA_IDENTITY_NAME=email-reminders-aca-pull

# Optional. When set, the same versioned image is deployed as a Celery worker
# using ./scripts/start-worker.sh.
ACA_WORKER_APP_NAME=email-reminders-worker

# ARM template used after the image is built and pushed.
ARM_TEMPLATE_FILE=infra/aca/azuredeploy.json

# Optional Docker build platform.
PLATFORM=linux/amd64

# Optional ACA runtime variables. Prefer secret references for real secrets once
# the Container App exists. Keep this line shell-quoted if values contain URL
# characters.
ACA_ENV_VARS='DATABASE_URL=postgresql://username:password@host:5432/email_reminders CELERY_BROKER_URL=rediss://:password@redis.redis.cache.windows.net:6380/0 CELERY_RESULT_BACKEND=rediss://:password@redis.redis.cache.windows.net:6380/1'

# The ARM template creates a user-assigned identity and grants it AcrPull on the
# registry. The deploying principal must be allowed to create role assignments
# on that ACR scope.
